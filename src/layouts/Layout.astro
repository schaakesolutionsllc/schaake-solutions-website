---
import { Image } from 'astro:assets';
import Link from '../components/Link.astro';
import ssLogo from '../assets/schaake-solutions-logo.png';
import SchaakeSolutionsLogo from '../components/SchaakeSolutionsLogo.astro'
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Schaake Solutions FLEX Equipment Finance" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="text-slate-800 bg-neutral-50 max-w-6xl mx-auto">
    <div class="sticky top-0 z-50 w-full bg-neutral-50">
      <div class="m-auto py-4 px-8 bg-slate-100 rounded drop-shadow">
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-x-2">
            <a href="/"><SchaakeSolutionsLogo heightClass="h-16"/></a>
            <div>
              <div class="text-3xl font-bold text-slate-600 drop-shadow mt-[3px]">Schaake Solutions</div>
              <div class="text-slate-700 italic">Powering Financial Innovation</div>
            </div>
          </div>
          <div>
            <Link href="mailto:info@schaake.solutions">Contact Us</Link>
          </div>
        </div>
      </div>
    </div>
    <main class="p-4 m-auto mt-2">
		  <slot />
    </main>
    <footer class="bg-gray-100 mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-4">Products & Services</h3>
            <ul class="space-y-2">
              <li><a href="/flex-equipment-finance" class="text-gray-600 hover:text-blue-600">FLEX Equipment Finance</a></li>
              <li><a href="/ai-consulting" class="text-gray-600 hover:text-blue-600">AI Consulting Services</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact</h3>
            <ul class="space-y-2">
              <li><Link href="mailto:info@schaake.solutions">info@schaake.solutions</Link></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Company</h3>
            <ul class="space-y-2">
              <li><a href="/" class="text-gray-600 hover:text-blue-600">Home</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 mt-8 pt-8 text-center text-gray-600">
          <p>&copy; {new Date().getFullYear()} Schaake Solutions. All rights reserved.</p>
        </div>
      </div>
    </footer>
	</body>
</html>
