---
import '../styles/global.css';
import SchaakeSolutionsLogo from '../components/SchaakeSolutionsLogo.astro';

interface Props {
	title: string;
}

const { title } = Astro.props;
const description = 'Mark Schaake builds business operating systems, AI-first: one system a business runs on, with portals for every stakeholder, payment flows, and day-to-day processes.';
const siteUrl = 'https://www.schaake.solutions/';
const ogImage = 'https://www.schaake.solutions/og.png';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={siteUrl} />
		<meta name="theme-color" content="#f6f4ef" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Schaake Solutions: I build business operating systems, AI-first." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
	</head>
	<body>
		<a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">Skip to content</a>

		<header class="border-b border-ink">
			<div class="mx-auto flex max-w-page flex-col gap-4 px-5 pt-6 md:flex-row md:items-center md:justify-between md:px-10 md:py-7">
				<a href="/" class="flex items-center gap-3 font-bold tracking-[-0.01em] text-ink transition-colors hover:text-accent">
					<SchaakeSolutionsLogo heightClass="h-7" />
					<span>Schaake Solutions</span>
				</a>
				<nav aria-label="Main" class="-mx-5 flex flex-wrap gap-x-5 border-t border-rule px-5 py-1 text-[0.9375rem] md:mx-0 md:gap-x-7 md:border-0 md:p-0">
					<a href="/#build" class="py-2 text-ink transition-colors hover:text-accent md:py-0 md:text-ink-2">What I Build</a>
					<a href="/#systems" class="py-2 text-ink transition-colors hover:text-accent md:py-0 md:text-ink-2">Systems</a>
					<a href="https://markschaake.com" class="py-2 text-ink transition-colors hover:text-accent md:py-0 md:text-ink-2">Writing</a>
					<a href="https://www.linkedin.com/in/mark-schaake" class="py-2 text-ink transition-colors hover:text-accent md:py-0 md:text-ink-2">LinkedIn</a>
					<a href="/#contact" class="py-2 text-ink transition-colors hover:text-accent md:py-0 md:text-ink-2">Contact</a>
				</nav>
			</div>
		</header>

		<div class="mx-auto max-w-page px-5 md:px-10">
			<div class="grid gap-6 border-b border-rule py-3.5 font-mono text-label text-ink-3 uppercase md:grid-cols-2">
				<span class="hidden md:block">Business operating systems, built AI-first.</span>
				<span class="md:text-right"><span class="mr-2 inline-block size-2 rounded-full bg-ok align-[1px]" aria-hidden="true"></span>Projects for fun · open to requests</span>
			</div>
		</div>

		<main id="main" tabindex="-1" class="focus:outline-none">
			<slot />
		</main>

		<footer class="text-sm leading-relaxed">
			<div class="mx-auto max-w-page px-5 pt-10 pb-14 md:px-10">
				<nav aria-label="Footer" class="grid grid-cols-2 gap-8 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
					<div class="col-span-2 md:col-span-1">
						<a href="/" class="flex items-center gap-3 font-bold tracking-[-0.01em] whitespace-nowrap text-ink transition-colors hover:text-accent">
							<SchaakeSolutionsLogo heightClass="h-7" />
							<span>Schaake Solutions</span>
						</a>
					</div>
					<div>
						<h4 class="mb-3 font-mono text-label-xs font-medium text-ink-3 uppercase">What I Build</h4>
						<ul class="grid gap-2">
							<li><a href="/#build" class="text-ink-2 transition-colors hover:text-accent">Portals for Every Stakeholder</a></li>
							<li><a href="/#build" class="text-ink-2 transition-colors hover:text-accent">Payments & Money Flows</a></li>
							<li><a href="/#build" class="text-ink-2 transition-colors hover:text-accent">Workflows, Built AI-First</a></li>
						</ul>
					</div>
					<div>
						<h4 class="mb-3 font-mono text-label-xs font-medium text-ink-3 uppercase">Contact</h4>
						<ul class="grid gap-2">
							<li><a href="mailto:info@schaake.solutions" class="[overflow-wrap:anywhere] text-ink-2 transition-colors hover:text-accent">info@<wbr />schaake.solutions</a></li>
							<li><a href="https://www.linkedin.com/in/mark-schaake" class="text-ink-2 transition-colors hover:text-accent">LinkedIn</a></li>
						</ul>
					</div>
					<div>
						<h4 class="mb-3 font-mono text-label-xs font-medium text-ink-3 uppercase">Company</h4>
						<ul class="grid gap-2">
							<li><a href="/" class="text-ink-2 transition-colors hover:text-accent">Home</a></li>
							<li><a href="/#systems" class="text-ink-2 transition-colors hover:text-accent">Systems</a></li>
							<li><a href="https://markschaake.com" class="text-ink-2 transition-colors hover:text-accent">Writing</a></li>
						</ul>
					</div>
				</nav>
				<p class="mt-10 border-t border-rule pt-5 text-ink-3">&copy; {year} Schaake Solutions. All rights reserved.</p>
			</div>
		</footer>
	</body>
</html>
