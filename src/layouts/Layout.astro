---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Schaake Solutions FLEX Equipment Finance" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="text-slate-800 bg-neutral-50">
    <div class="sticky top-0 z-50 w-full bg-neutral-50">
      <div class="container m-auto p-2 bg-blue-50 rounded drop-shadow">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-x-2">
          <a href="/"><img src="/ss-logo.webp" class="w-24 inline drop-shadow-xl"/></a>
          <div class="space-y-1">
            <div class="text-3xl font-bold text-slate-600 drop-shadow">Schaake Solutions</div>
            <div class="text-slate-700 italic">Fintech innovations since 2017</div>
          </div>
        </div>
        <div>
          <a href="mailto:info@schaake.solutions" class="text-blue-600 hover:text-blue-800 underline">Contact Us</a>
        </div>
      </div>
      </div>
    </div>
    <main class="p-4 container m-auto mt-2">
		  <slot />
    </main>
	</body>
</html>
