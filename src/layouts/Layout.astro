---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Schaake Solutions FLEX Equipment Finance" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="text-slate-800 bg-neutral-50">
    <div class="sticky top-0 z-50 w-full bg-neutral-50">
      <div class="container m-auto p-2 bg-blue-50 rounded drop-shadow">
      <div class="flex justify-between items-center">
        <div class="flex items-center gap-x-2">
          <a href="/"><img src="/ss-logo.webp" class="w-16 inline drop-shadow-xl"/></a>
          <div>
            <div class="text-3xl font-bold text-slate-600 drop-shadow mt-[3px]">Schaake Solutions</div>
            <div class="text-slate-700 italic">Innovating since 2017</div>
          </div>
        </div>
        <div>
          <a href="mailto:info@schaake.solutions" class="text-blue-600 hover:text-blue-800 underline">Contact Us</a>
        </div>
      </div>
      </div>
    </div>
    <main class="p-4 container m-auto mt-2">
		  <slot />
    </main>
    <footer class="bg-gray-100 mt-16">
      <div class="container mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-semibold mb-4">Products</h3>
            <ul class="space-y-2">
              <li><a href="/flex-equipment-finance" class="text-gray-600 hover:text-blue-600">FLEX Equipment Finance</a></li>
              <li><a href="/flex-premium-finance" class="text-gray-600 hover:text-blue-600">FLEX Premium Finance</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Contact</h3>
            <ul class="space-y-2">
              <li><a href="mailto:info@schaake.solutions" class="text-gray-600 hover:text-blue-600">info@schaake.solutions</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-semibold mb-4">Company</h3>
            <ul class="space-y-2">
              <li><a href="/" class="text-gray-600 hover:text-blue-600">Home</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-200 mt-8 pt-8 text-center text-gray-600">
          <p>&copy; {new Date().getFullYear()} Schaake Solutions. All rights reserved.</p>
        </div>
      </div>
    </footer>
	</body>
</html>
