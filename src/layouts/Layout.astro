---
import { Image } from 'astro:assets';
import Link from '../components/Link.astro';
import SchaakeSolutionsLogo from '../components/SchaakeSolutionsLogo.astro'
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Schaake Solutions FLEX Equipment Finance" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="text-slate-800 bg-gradient-to-br from-slate-50 via-blue-50/40 to-cyan-50/20 max-w-6xl mx-auto">
    <div class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/80 border-b border-white/20 shadow-lg shadow-blue-500/5">
      <div class="m-auto py-4 px-8">
        <div class="flex justify-between items-center">
          <div class="flex items-center gap-x-3">
            <a href="/" class="transition-transform hover:scale-105 duration-200"><SchaakeSolutionsLogo heightClass="h-16"/></a>
            <div>
              <div class="text-3xl font-bold bg-gradient-to-r from-blue-600 via-sky-600 to-cyan-600 bg-clip-text text-transparent mt-[3px]">Schaake Solutions</div>
              <div class="text-slate-600 text-sm font-medium">Software. Leadership. Innovation.</div>
            </div>
          </div>
          <div>
            <Link href="mailto:info@schaake.solutions" class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-cyan-600 text-white rounded-lg font-medium hover:shadow-lg hover:shadow-blue-500/50 transition-all duration-200 hover:scale-[1.02]">Contact Us</Link>
          </div>
        </div>
      </div>
    </div>
    <main class="p-4 m-auto mt-8">
		  <slot />
    </main>
    <footer class="mt-24 bg-gradient-to-br from-slate-900 via-blue-900/90 to-slate-900 text-white relative overflow-hidden">
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40"></div>
      <div class="container mx-auto px-4 py-12 relative">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="text-lg font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Products & Services</h3>
            <ul class="space-y-3">
              <li><a href="/flex-equipment-finance" class="text-gray-300 hover:text-white transition-colors duration-200 hover:translate-x-1 inline-block">FLEX Equipment Finance</a></li>
              <li><a href="/services" class="text-gray-300 hover:text-white transition-colors duration-200 hover:translate-x-1 inline-block">Consulting Services</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Contact</h3>
            <ul class="space-y-3">
              <li><Link href="mailto:info@schaake.solutions" class="text-gray-300 hover:text-white transition-colors duration-200">info@schaake.solutions</Link></li>
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-4 bg-gradient-to-r from-blue-400 to-cyan-400 bg-clip-text text-transparent">Company</h3>
            <ul class="space-y-3">
              <li><a href="/" class="text-gray-300 hover:text-white transition-colors duration-200 hover:translate-x-1 inline-block">Home</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-white/10 pt-8 text-center text-gray-400">
          <p>&copy; {new Date().getFullYear()} Schaake Solutions. All rights reserved.</p>
        </div>
      </div>
    </footer>
	</body>
</html>
