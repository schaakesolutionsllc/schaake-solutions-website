---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import FlexLogo from '../components/FlexLogo.astro';
import { Image } from 'astro:assets';
import landingBackground from '../assets/landing-page-background.webp';
---

<Layout title="Schaake Solutions">
  <div class="space-y-8 divide-y">
    <div class="relative w-full h-[400px] mb-16 rounded-lg overflow-hidden">
      <Image 
        src={landingBackground} 
        alt="Landing page background" 
        class="object-cover w-full h-full"
      />
      <div class="absolute inset-0 bg-black bg-opacity-40 flex items-center justify-center">
        <h1 class="text-4xl md:text-5xl text-white font-bold text-center px-4">
          Empowering Finance Through Technology
        </h1>
      </div>
    </div>
    
    <section class="flex flex-col md:flex-row gap-8 p-8">
      <div class="w-full md:w-1/4">
        <h2 class="text-2xl font-bold drop-shadow">Our Mission</h2>
      </div>
      <div class="w-full md:w-3/4">
	      <p class="max-w-prose">
          Schaake Solutions provides state-of-the-art software-as-a-service (SaaS) platforms for finance companies.
        Our solutions deliver real-time data processing, intuitive user interfaces, and robust security features
        while scaling seamlessly with your business. From comprehensive analytics to automated workflows,
        our feature-rich platforms empower financial institutions to operate efficiently and grow confidently.
        </p>
      </div>
    </section>

    <section class="flex flex-col md:flex-row gap-8 p-8">
      <div class="w-full md:w-1/4">
        <h2 class="text-2xl font-bold drop-shadow">Our Solutions</h2>
      </div>
      <div class="w-full md:w-3/4 flex flex-row gap-x-4 gap-y-4 flex-wrap">
        <div class="w-full md:w-min md:min-w-80 rounded-lg link-card hover:bg-white flex p-1 border shadow hover:shadow-md">
	        <a class="w-full p-2" href="flex-equipment-finance">
            <div class="flex justify-between items-center">
		          <h2 class="m-0 font-bold text-xl flex gap-x-2 items-center">
			          <FlexLogo heightClass="h-8"/> FLEX Equipment Finance
		          </h2>
            </div>
		        <p class="mt-2 mb-0">
              A comprehensive SaaS platform that streamlines the entire equipment financing lifecycle, from loan origination to servicing. The platform combines powerful integrations, AI-assisted underwriting, and robust portfolio management tools to modernize B2B equipment financing operations.
		        </p>
	        </a>
        </div>
      </div>
    </section>

    <section class="flex flex-col md:flex-row gap-8 p-8">
      <div class="w-full md:w-1/4">
        <h2 class="text-2xl font-bold drop-shadow">AI Consulting</h2>
      </div>
      <div class="w-full md:w-3/4 flex flex-row gap-x-4 gap-y-4 flex-wrap">
        <div class="w-full md:w-min md:min-w-80 rounded-lg link-card hover:bg-white flex p-1 border shadow hover:shadow-md">
	        <a class="w-full p-2" href="ai-consulting">
            <div class="flex justify-between items-center">
		          <h2 class="m-0 font-bold text-xl flex gap-x-2 items-center">
			          AI Consulting Services
		          </h2>
            </div>
		        <p class="mt-2 mb-0">
              Expert AI consulting to help your business stay ahead of the AI revolution. We provide strategic guidance, implementation support, and custom AI solutions tailored to your specific needs and industry challenges.
		        </p>
	        </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

