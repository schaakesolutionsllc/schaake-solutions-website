---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import FlexLogo from '../components/FlexLogo.astro';
import { Image } from 'astro:assets';
import landingBackground from '../assets/landing-page-background.webp';
---

<Layout title="Schaake Solutions">
  <div class="space-y-16">
    <div class="relative w-full h-[500px] mb-16 rounded-2xl overflow-hidden shadow-2xl shadow-blue-500/20">
      <Image
        src={landingBackground}
        alt="Landing page background"
        class="object-cover w-full h-full"
      />
      <div class="absolute inset-0 bg-gradient-to-br from-blue-900/80 via-sky-900/70 to-cyan-900/80 flex items-center justify-center">
        <div class="text-center px-4 animate-fade-in">
          <h1 class="text-5xl md:text-7xl text-white font-bold mb-6 drop-shadow-2xl">
            AI-First Software Solutions
          </h1>
          <p class="text-xl md:text-2xl text-blue-100 font-light max-w-3xl mx-auto">
            Building tomorrow's intelligent software today
          </p>
        </div>
      </div>
    </div>

    <section class="p-8 rounded-3xl bg-gradient-to-br from-white/80 to-blue-50/50 backdrop-blur-sm border border-white/20 shadow-xl">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <div class="w-full md:w-1/4">
          <h2 class="text-3xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">Our Mission</h2>
        </div>
        <div class="w-full md:w-3/4">
	      <p class="text-lg text-slate-700 leading-relaxed">
          Schaake Solutions delivers AI-first software platforms and technical leadership for growing businesses. We create state-of-the-art SaaS solutions and provide strategic consulting and CTO services to help companies leverage AI, modernize their technology stack, and accelerate product development.
        </p>
      </div>
      </div>
    </section>

    <section class="p-8">
      <div class="mb-8">
        <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-4">Our SaaS Platforms</h2>
      </div>
      <div class="flex justify-center">
        <a href="flex-equipment-finance" class="group block w-full max-w-3xl">
          <div class="relative rounded-2xl bg-gradient-to-br from-white via-blue-50/30 to-cyan-50/30 backdrop-blur-sm border border-blue-200/50 p-8 shadow-xl hover:shadow-2xl hover:shadow-blue-500/20 transition-all duration-200 overflow-hidden hover:scale-[1.01]">
            <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-blue-500/10 to-cyan-500/10 rounded-full blur-3xl"></div>
            <div class="relative">
              <div class="flex items-center gap-3 mb-4">
                <FlexLogo heightClass="h-10"/>
                <h3 class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent">FLEX Equipment Finance</h3>
              </div>
              <p class="text-slate-600 leading-relaxed text-lg">
                A comprehensive SaaS platform that streamlines the entire equipment financing lifecycle, from loan origination to servicing. The platform combines powerful integrations, AI-assisted underwriting, and robust portfolio management tools to modernize B2B equipment financing operations.
              </p>
              <div class="mt-6 inline-flex items-center text-blue-600 font-semibold group-hover:translate-x-2 transition-transform duration-200">
                Learn more <span class="ml-2">→</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>

    <section class="p-8">
      <div class="mb-8">
        <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-blue-600 to-cyan-600 bg-clip-text text-transparent mb-4">Consulting & CTO Services</h2>
      </div>
      <div class="flex justify-center">
        <a href="services" class="group block w-full max-w-3xl">
          <div class="relative rounded-2xl bg-gradient-to-br from-white via-sky-50/30 to-blue-50/30 backdrop-blur-sm border border-sky-200/50 p-8 shadow-xl hover:shadow-2xl hover:shadow-sky-500/20 transition-all duration-200 overflow-hidden hover:scale-[1.01]">
            <div class="absolute top-0 right-0 w-64 h-64 bg-gradient-to-br from-sky-500/10 to-blue-500/10 rounded-full blur-3xl"></div>
            <div class="relative">
              <h3 class="text-2xl font-bold bg-gradient-to-r from-sky-600 to-blue-600 bg-clip-text text-transparent mb-4">Consulting Services & Fractional CTO</h3>
              <p class="text-slate-600 leading-relaxed text-lg">
                Strategic technology consulting to help your business leverage AI and modern software development practices. We provide expert guidance on incorporating AI into your software products, AI-first development methodologies, fractional CTO services, and are available for true founder CTO roles to help you make critical technical decisions and accelerate your product development.
              </p>
              <div class="mt-6 inline-flex items-center text-sky-600 font-semibold group-hover:translate-x-2 transition-transform duration-200">
                Learn more <span class="ml-2">→</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </section>
  </div>
</Layout>

