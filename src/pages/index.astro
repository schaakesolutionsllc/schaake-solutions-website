---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import landingBackground from '../assets/landing-page-background.webp';
---

<Layout title="Schaake Solutions - Strategic Technology Leadership & AI Consulting">
  <div class="space-y-16">
    <!-- Hero Section -->
    <div class="relative w-full h-[500px] mb-16 rounded-2xl overflow-hidden shadow-2xl shadow-slate-900/50">
      <Image
        src={landingBackground}
        alt="Landing page background"
        class="object-cover w-full h-full"
      />
      <div class="absolute inset-0 bg-slate-950/80 flex items-center justify-center">
        <div class="text-center px-4 animate-fade-in">
          <h1 class="text-4xl md:text-5xl text-white font-bold mb-4">
            Hi, I'm Mark Schaake.
          </h1>
          <p class="text-xl md:text-2xl text-cyan-400 font-medium max-w-3xl mx-auto mb-4">
            I bridge the gap between heavy-duty software engineering and the AI-first future.
          </p>
          <p class="text-lg md:text-xl text-slate-300 font-light max-w-3xl mx-auto mb-8">
            I help startups and established companies navigate technical pivots, build production-grade AI integrations, and establish the leadership needed to ship high-stakes software.
          </p>
          <div class="flex items-center justify-center gap-4">
            <a href="https://calendly.com/mark-schaake/30min" target="_blank" rel="noopener noreferrer" class="inline-block px-8 py-3 bg-cyan-600 hover:bg-cyan-500 text-white text-lg rounded-xl font-semibold transition-all duration-200 hover:scale-[1.02]">
              Schedule a Call
            </a>
            <a href="https://www.linkedin.com/in/mark-schaake" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 border border-slate-600 hover:border-slate-500 text-slate-300 hover:text-white text-lg rounded-xl font-medium transition-all duration-200 hover:scale-[1.02]">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Services Section -->
    <section id="services" class="pt-8 mb-16 scroll-mt-24">
      <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent mb-12">Services</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="group rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 p-8 transition-all duration-200 hover:scale-[1.01]">
          <h3 class="text-2xl font-bold text-cyan-400 mb-4">Fractional CTO</h3>
          <p class="text-slate-300 mb-6 leading-relaxed">
            I provide the strategic distance and technical oversight of a veteran CTO without the full-time overhead. Whether you're selecting a new stack or mentoring an early engineering team, I ensure your roadmap is technically sound and ready to scale.
          </p>
          <ul class="space-y-2 text-slate-300">
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Technical strategy and roadmaps</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Architecture design and review</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Team building and mentorship</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Stack selection and evaluation</li>
          </ul>
        </div>

        <div class="group rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 p-8 transition-all duration-200 hover:scale-[1.01]">
          <h3 class="text-2xl font-bold text-cyan-400 mb-4">AI Implementation</h3>
          <p class="text-slate-300 mb-6 leading-relaxed">
            I don't just talk about AI strategy; I build the pipelines. I focus on moving companies past simple "chatbot wrappers" into deep, agentic automations—including high-reliability underwriting systems and production-grade LLM integrations.
          </p>
          <ul class="space-y-2 text-slate-300">
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Agentic AI workflows</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>LLM integration and fine-tuning</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>AI-assisted decision systems</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Use case identification</li>
          </ul>
        </div>

        <div class="group rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 p-8 transition-all duration-200 hover:scale-[1.01]">
          <h3 class="text-2xl font-bold text-cyan-400 mb-4">Technical Consulting</h3>
          <p class="text-slate-300 mb-6 leading-relaxed">
            I help teams solve hard problems—architecture reviews, performance bottlenecks, security audits, and DevOps optimization. I bring 20 years of building production systems to every engagement.
          </p>
          <ul class="space-y-2 text-slate-300">
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>System architecture review</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Code and security audits</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>DevOps optimization</li>
            <li class="flex items-start"><span class="text-cyan-500 mr-2">▸</span>Performance and scalability</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Approach Section -->
    <section id="approach" class="pt-8 mb-16 scroll-mt-24">
      <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent mb-12">My Approach</h2>
      <div class="rounded-3xl bg-slate-900 border border-slate-800 p-10">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div class="text-center group">
            <div class="w-20 h-20 bg-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-200">
              <span class="text-white text-3xl font-bold">1</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-100 mb-4">Assess</h3>
            <p class="text-slate-300 leading-relaxed">
              I analyze your current processes, data infrastructure, and business objectives to identify high-impact opportunities.
            </p>
          </div>

          <div class="text-center group">
            <div class="w-20 h-20 bg-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-200">
              <span class="text-white text-3xl font-bold">2</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-100 mb-4">Design</h3>
            <p class="text-slate-300 leading-relaxed">
              I create tailored solutions that align with your specific needs, ensuring practical and achievable implementations.
            </p>
          </div>

          <div class="text-center group">
            <div class="w-20 h-20 bg-cyan-600 rounded-2xl flex items-center justify-center mx-auto mb-6 group-hover:scale-110 transition-transform duration-200">
              <span class="text-white text-3xl font-bold">3</span>
            </div>
            <h3 class="text-2xl font-bold text-slate-100 mb-4">Implement</h3>
            <p class="text-slate-300 leading-relaxed">
              I deploy solutions with minimal disruption, provide comprehensive support, and ensure successful adoption across your organization.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Track Record Section -->
    <section id="track-record" class="pt-8 mb-16 scroll-mt-24">
      <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent mb-12">Track Record</h2>
      <div class="rounded-3xl bg-slate-900 border border-slate-800 p-10">
        <div class="max-w-3xl mx-auto">
          <p class="text-lg text-slate-300 leading-relaxed mb-6">
            I built <strong class="text-slate-100">FLEX</strong>—an AI-powered equipment finance platform—from the ground up. It handles the entire B2B financing lifecycle from origination to servicing, processing real loans in a regulated financial environment.
          </p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 flex-shrink-0"></div>
              <p class="text-slate-300">AI-assisted underwriting and credit decisioning</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 flex-shrink-0"></div>
              <p class="text-slate-300">Integration with DocuSign, PayNet, Equifax, LexisNexis</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 flex-shrink-0"></div>
              <p class="text-slate-300">Full loan lifecycle management and servicing</p>
            </div>
            <div class="flex items-start gap-3">
              <div class="w-2 h-2 bg-cyan-500 rounded-full mt-2 flex-shrink-0"></div>
              <p class="text-slate-300">Modern cloud architecture on AWS</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Current Thinking Section -->
    <section class="pt-8 mb-16">
      <div class="rounded-3xl bg-slate-900/50 border border-slate-800 p-10">
        <div class="max-w-3xl mx-auto text-center">
          <h2 class="text-2xl font-bold text-slate-100 mb-4">Current Thinking</h2>
          <p class="text-lg text-slate-300 leading-relaxed mb-6">
            Right now, I'm exploring the "Disposability" of software—leveraging agentic AI to build custom, high-performance internal tools that were previously too expensive to justify.
          </p>
          <a href="https://markschaake.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-medium transition-colors duration-200">
            Read more on my blog
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="pt-8 mb-16 scroll-mt-24">
      <h2 class="text-4xl font-bold text-center bg-gradient-to-r from-cyan-400 to-teal-400 bg-clip-text text-transparent mb-12">Let's Talk</h2>
      <div class="rounded-3xl bg-slate-900 border border-slate-800 p-12 text-center">
        <p class="text-xl text-slate-300 mb-8 max-w-2xl mx-auto leading-relaxed">
          Ready to discuss your project? Book a 30-minute call and let's explore how I can help.
        </p>
        <div class="text-center">
          <a href="https://calendly.com/mark-schaake/30min" target="_blank" rel="noopener noreferrer" class="inline-block px-10 py-4 bg-cyan-600 hover:bg-cyan-500 text-white text-lg rounded-xl font-semibold transition-all duration-200 hover:scale-[1.02]">
            Schedule a Call
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
