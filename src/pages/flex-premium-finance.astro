---
import Layout from '../layouts/Layout.astro';
import FlexLogo from '../components/FlexLogo.astro';
---

<Layout title="Schaake Solutions - FLEX Premium Finance">
  <div class="max-w-6xl mx-auto divide-y">
    <div class="sticky top-24 z-40 bg-white shadow-md rounded py-4 mb-4 flex flex-col items-center">
      <h1 class="text-4xl font-bold text-gray-700 flex items-center gap-x-2"><FlexLogo heightClass="h-8"/>FLEX Premium Finance</h1>
    </div>

    <div class="prose pt-12 mb-12 space-y-4">
      <p class="text-lg text-gray-700">
        A comprehensive SaaS platform and marketplace facilitating insurance premium financing.
      </p>
      <p class="italic">
        <b>Coming in 2025.</b>
      </p>
    </div>
  </div>
</Layout>

