---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Schaake Solutions - FLEX Premium Finance">
  <div class="max-w-4xl mx-auto p-8">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">FLEX Premium Finance</h1>
    
    <div class="prose mb-8">
      <p class="text-lg text-gray-700">
        A comprehensive SaaS platform and marketplace facilitating insurance premium financing.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Integrated Portals</h2>
        <ul class="list-disc list-inside text-gray-600">
          <li>Insurance Agents</li>
          <li>Lenders</li>
          <li>Borrowers</li>
        </ul>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Key Integrations</h2>
        <ul class="list-disc list-inside text-gray-600">
          <li>DocuSign</li>
          <li>PayNet</li>
          <li>EquiFax</li>
          <li>LexisNexis</li>
          <li>Google Docs</li>
        </ul>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Loan Underwriting</h2>
        <ul class="list-disc list-inside text-gray-600">
          <li>Combined credit analysis</li>
          <li>AI Document detection</li>
          <li>AI-powered assistance</li>
        </ul>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Loan Agreements</h2>
        <ul class="list-disc list-inside text-gray-600">
          <li>Flexible loan structuring</li>
          <li>Integrated DocuSign workflow</li>
          <li>Borrower AutoPay</li>
          <li>ACH Vendor Funding</li>
        </ul>
      </div>

      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-xl font-semibold text-gray-800 mb-4">Loan Servicing</h2>
        <ul class="list-disc list-inside text-gray-600">
          <li>AutoPay management</li>
          <li>Payment alerts</li>
          <li>AI troubleshooting</li>
          <li>Automated notices</li>
        </ul>
      </div>
    </div>

    <div class="mt-8 bg-blue-50 rounded-lg p-6">
      <h2 class="text-xl font-semibold text-gray-800 mb-4">Portfolio Management</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-gray-600">
        <ul class="list-disc list-inside">
          <li>General ledger accounting</li>
          <li>Custom reporting</li>
          <li>Trend visualization</li>
        </ul>
        <ul class="list-disc list-inside">
          <li>Funding forecasting</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

