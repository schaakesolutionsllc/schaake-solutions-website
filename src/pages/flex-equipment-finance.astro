---
import Layout from '../layouts/Layout.astro';
import FlexLogo from '../components/FlexLogo.astro';
---

<Layout title="Schaake Solutions - FLEX Equipment Finance">
  <div class="max-w-6xl mx-auto p-8 divide-y">
    <div class="sticky top-20 z-40 bg-white shadow-md rounded-lg pt-8 mb-8 flex flex-col items-center">
      <h1 class="text-4xl font-bold text-gray-900 flex items-center gap-x-2"><FlexLogo heightClass="h-8"/>FLEX Equipment Finance</h1>

      <!-- Navigation Bar -->
      <nav class="">
        <ul class="flex justify-center space-x-8 p-4">
          <li>
            <a href="#portal" class="nav-link text-gray-600 hover:text-blue-600 transition-colors">Portal Access</a>
          </li>
          <li>
            <a href="#loan" class="nav-link text-gray-600 hover:text-blue-600 transition-colors">Loan Processing</a>
          </li>
          <li>
            <a href="#servicing" class="nav-link text-gray-600 hover:text-blue-600 transition-colors">Servicing</a>
          </li>
          <li>
            <a href="#testimonials" class="nav-link text-gray-600 hover:text-blue-600 transition-colors">Testimonials</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="prose pt-12 mb-12">
      <p class="text-lg text-gray-700">
        A comprehensive SaaS platform and marketplace facilitating B2B equipment financing through loan origination, servicing, and non-performing contract resolutions.
      </p>
    </div>
    

    <!-- Portal Access Section -->
    <section id="portal" class="pt-8 mb-8 scroll-mt-48">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/2">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Portal Access & Integrations</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">User Portals</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Originators</li>
              <li>Lenders</li>
              <li>Borrowers</li>
              <li>Collectors</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Key Integrations</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>DocuSign</li>
              <li>PayNet</li>
              <li>EquiFax</li>
              <li>LexisNexis</li>
              <li>Google Docs</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-1/2 bg-gray-100 rounded-lg p-4 flex items-center justify-center">
          <div class="text-gray-500 text-center">
            <p class="text-lg font-semibold">Portal Screenshot</p>
            <p class="text-sm">(Placeholder)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Loan Processing Section -->
    <section id="loan" class="pt-8 mb-8 scroll-mt-48">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/2">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Loan Processing</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Underwriting</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Combined credit analysis</li>
              <li>Document detection</li>
              <li>AI-powered assistance</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Agreements</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Flexible loan structuring</li>
              <li>Configurable Pricing Guide</li>
              <li>Integrated DocuSign workflow</li>
              <li>Borrower AutoPay</li>
              <li>ACH Vendor Funding</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-1/2 bg-gray-100 rounded-lg p-4 flex items-center justify-center">
          <div class="text-gray-500 text-center">
            <p class="text-lg font-semibold">Loan Processing Screenshot</p>
            <p class="text-sm">(Placeholder)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Servicing Section -->
    <section id="servicing" class="pt-8 mb-8 scroll-mt-48">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/2">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Servicing & Portfolio Management</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Servicing</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>AutoPay (ACH)</li>
              <li>Payment failure alerts</li>
              <li>AI troubleshooting</li>
              <li>Automated notices</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Portfolio Management</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>General ledger accounting</li>
              <li>Custom reporting</li>
              <li>Trend visualization</li>
              <li>Funding forecasting</li>
              <li>Equipment resale management</li>
              <li>Deficiency tracking</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-1/2 bg-gray-100 rounded-lg p-4 flex items-center justify-center">
          <div class="text-gray-500 text-center">
            <p class="text-lg font-semibold">Servicing Screenshot</p>
            <p class="text-sm">(Placeholder)</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="pt-8 mb-8 scroll-mt-48">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">Client Testimonials</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Mark Capital Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 bg-gray-100 rounded mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-sm text-center">Logo Placeholder</p>
          </div>
          <p class="text-gray-600 italic mb-4">"FLEX Equipment Finance has streamlined our entire lending process, making it easier than ever to serve our customers."</p>
          <div class="text-gray-800 font-semibold">Mark Capital Finance, LLC</div>
        </div>

        <!-- West One Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 bg-gray-100 rounded mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-sm text-center">Logo Placeholder</p>
          </div>
          <p class="text-gray-600 italic mb-4">"The automated underwriting features have significantly reduced our processing time while maintaining high quality standards."</p>
          <div class="text-gray-800 font-semibold">West One Finance, LLC</div>
        </div>

        <!-- Timberline Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 bg-gray-100 rounded mb-4 flex items-center justify-center">
            <p class="text-gray-500 text-sm text-center">Logo Placeholder</p>
          </div>
          <p class="text-gray-600 italic mb-4">"The portfolio management tools have given us unprecedented visibility into our lending operations."</p>
          <div class="text-gray-800 font-semibold">Timberline Finance, LLC</div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
// Scroll spy functionality
const sections = document.querySelectorAll('section[id]');
const navLinks = document.querySelectorAll('.nav-link');

const observerOptions = {
  rootMargin: '-20% 0px -70% 0px'
};

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting) {
      // Remove active class from all links
      navLinks.forEach(link => {
        link.classList.remove('text-blue-600', 'font-semibold');
        link.classList.add('text-gray-600');
      });
        
      // Add active class to current section's link
      const activeLink = document.querySelector(`.nav-link[href="#${entry.target.id}"]`);
      if (activeLink) {
        activeLink.classList.remove('text-gray-600');
        activeLink.classList.add('text-blue-600', 'font-semibold');
      }
    }
  });
}, observerOptions);

sections.forEach(section => observer.observe(section));

// Smooth scroll behavior
navLinks.forEach(link => {
  link.addEventListener('click', (e) => {
    e.preventDefault();
    const targetId = link.getAttribute('href');
    const targetSection = document.querySelector(targetId);
    targetSection.scrollIntoView({ behavior: 'smooth' });
  });
});
</script>

