---
import { Image } from 'astro:assets';
import Link from '../components/Link.astro';
import westOneLogo from '../assets/west-one-logo.png';
import timberlineLogo from '../assets/timberline-logo.webp';
import markCapitalLogo from '../assets/mark-capital-logo.png';
import screenshot1 from '../assets/screenshot_originator_1.png';
import screenshot2 from '../assets/screenshot_credit_flex-ai2.png';
import screenshot3 from '../assets/screenshot_lender_trends.png';
import Layout from '../layouts/Layout.astro';
import FlexLogo from '../components/FlexLogo.astro';
---

<Layout title="Schaake Solutions - FLEX Equipment Finance">
  <div class="max-w-6xl mx-auto divide-y">
    <div class="sticky top-24 z-40 bg-white shadow-md rounded py-4 px-6 mb-4">
      <div class="flex justify-between items-center">
        <h1 class="text-3xl font-bold text-gray-700 flex items-center gap-x-2">
          <FlexLogo heightClass="h-6"/>FLEX Equipment Finance
        </h1>
        
        <!-- Desktop Navigation -->
        <nav class="hidden md:flex gap-6">
          <a href="#portal" class="text-gray-600 hover:text-gray-900 nav-link" data-section="portal">Portal Access</a>
          <a href="#loan" class="text-gray-600 hover:text-gray-900 nav-link" data-section="loan">Loan Processing</a>
          <a href="#servicing" class="text-gray-600 hover:text-gray-900 nav-link" data-section="servicing">Servicing</a>
          <a href="#testimonials" class="text-gray-600 hover:text-gray-900 nav-link" data-section="testimonials">Testimonials</a>
          <a href="#pricing" class="text-gray-600 hover:text-gray-900 nav-link" data-section="pricing">Pricing</a>
        </nav>

        <!-- Mobile Menu Button -->
        <button id="menuButton" class="md:hidden text-gray-600 hover:text-gray-900">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Navigation -->
      <div id="mobileMenu" class="hidden md:hidden mt-4 py-2">
        <nav class="flex flex-col gap-2">
          <a href="#portal" class="text-gray-600 hover:text-gray-900 py-2 nav-link" data-section="portal">Portal Access</a>
          <a href="#loan" class="text-gray-600 hover:text-gray-900 py-2 nav-link" data-section="loan">Loan Processing</a>
          <a href="#servicing" class="text-gray-600 hover:text-gray-900 py-2 nav-link" data-section="servicing">Servicing</a>
          <a href="#testimonials" class="text-gray-600 hover:text-gray-900 py-2 nav-link" data-section="testimonials">Testimonials</a>
          <a href="#pricing" class="text-gray-600 hover:text-gray-900 py-2 nav-link" data-section="pricing">Pricing</a>
        </nav>
      </div>
    </div>

    <script>
      const menuButton = document.getElementById('menuButton');
      const mobileMenu = document.getElementById('mobileMenu');
      const navLinks = document.querySelectorAll('.nav-link');

      // Mobile menu toggle
      menuButton?.addEventListener('click', () => {
        mobileMenu?.classList.toggle('hidden');
      });

      // Close mobile menu when clicking a link
      const mobileLinks = mobileMenu?.getElementsByTagName('a');
      if (mobileLinks) {
        Array.from(mobileLinks).forEach(link => {
          link.addEventListener('click', () => {
            mobileMenu?.classList.add('hidden');
          });
        });
      }

      // Intersection Observer for section highlighting
      const observerOptions = {
        root: null,
        rootMargin: '-50% 0px',
        threshold: 0
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            // Remove active class from all links
            navLinks.forEach(link => {
              link.classList.remove('text-blue-600', 'font-semibold');
              link.classList.add('text-gray-600');
            });
            
            // Add active class to corresponding nav link
            const activeLinks = document.querySelectorAll(`.nav-link[data-section="${entry.target.id}"]`);
            activeLinks.forEach(link => {
              link.classList.remove('text-gray-600');
              link.classList.add('text-blue-600', 'font-semibold');
            });
          }
        });
      }, observerOptions);

      // Observe all sections
      document.querySelectorAll('section[id]').forEach((section) => {
        observer.observe(section);
      });
    </script>

    <div class="prose pt-12 mb-12">
      <p class="text-lg text-gray-700">
        A comprehensive SaaS platform and marketplace facilitating B2B equipment financing through loan origination, servicing, and non-performing contract resolutions.
      </p>
    </div>
    

    <!-- Portal Access Section -->
    <section id="portal" class="pt-8 mb-8 scroll-mt-40">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/3">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Portal Access & Integrations</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">User Portals</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Originators</li>
              <li>Lenders (and Read-Only Auditors)</li>
              <li>Borrowers</li>
              <li>Collectors</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Key Integrations</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>DocuSign</li>
              <li>PayNet</li>
              <li>EquiFax</li>
              <li>LexisNexis</li>
              <li>Google Docs</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-2/3 shadow-lg">
          <Image src={screenshot1} alt="Originator Portal"/>
        </div>
      </div>
    </section>

    <!-- Loan Processing Section -->
    <section id="loan" class="pt-8 mb-8 scroll-mt-40">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/3">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Loan Processing</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Underwriting</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Combined credit analysis</li>
              <li>Document detection</li>
              <li>AI-powered assistance</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Agreements</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>Flexible loan structuring</li>
              <li>Configurable Pricing Guide</li>
              <li>Integrated DocuSign workflow</li>
              <li>Borrower AutoPay</li>
              <li>ACH Vendor Funding</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-2/3 shadow-lg">
          <Image src={screenshot2} alt="FLEX AI"/>
        </div>
      </div>
    </section>

    <!-- Servicing Section -->
    <section id="servicing" class="pt-8 mb-8 scroll-mt-40">
      <div class="flex flex-col md:flex-row gap-8">
        <div class="w-full md:w-1/3">
          <h2 class="text-2xl font-semibold text-gray-800 mb-6">Servicing & Portfolio Management</h2>
          <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Loan Servicing</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>AutoPay</li>
              <li>Payment failure alerts</li>
              <li>AI troubleshooting</li>
              <li>Automated notices</li>
            </ul>
          </div>
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-semibold text-gray-800 mb-4">Portfolio Management</h3>
            <ul class="list-disc list-inside text-gray-600">
              <li>General ledger accounting</li>
              <li>Custom reporting</li>
              <li>Trend visualization</li>
              <li>Funding forecasting</li>
              <li>Equipment resale management</li>
              <li>Deficiency tracking</li>
            </ul>
          </div>
        </div>
        <div class="w-full md:w-2/3 shadow-lg">
          <Image src={screenshot3} alt="Lender Dashboard"/>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section id="testimonials" class="pt-8 mb-8 scroll-mt-40">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">Client Testimonials</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Mark Capital Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 rounded mb-4 p-1 flex items-center justify-center drop-shadow">
            <Image src={markCapitalLogo} alt="Mark Capital Finance"/>
          </div>
          <p class="text-gray-600 italic mb-4">"FLEX has enabled us to scale to a 20MM loan portfolio with only three people. We joke that our day-to-day work is letting FLEX "boss us around": FLEX alerts us of any issues that need attention while guiding us through complex workflows minimizing our opportunities to make mistakes."</p>
          <div class="text-gray-800 font-semibold">Mark Capital Finance, LLC</div>
        </div>

        <!-- West One Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 rounded mb-4 p-1 flex items-center justify-center drop-shadow">
            <Image src={westOneLogo} alt="West One Finance"/>
          </div>
          <p class="text-gray-600 italic mb-4">"FLEX is the premier end to end software program for the Equipment Finance industry, it is intuitive, and very user friendly. Mark is very knowledgeable in the finance industry, and you can see that reflected in every aspect of the program. FLEX is always evolving and improving to help us do our job faster and more efficiently. Mark provides excellent customer service and we are so grateful for this amazing software program."</p>
          <div class="text-gray-800 font-semibold">West One Finance, LLC</div>
        </div>

        <!-- Timberline Finance Testimonial -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <div class="h-16 w-32 rounded mb-4 p-1 flex items-center justify-center drop-shadow">
            <Image src={timberlineLogo} alt="Timberline Finance"/>
          </div>
          <p class="text-gray-600 italic mb-4">"The efficiency of FLEX and ease of leveraging its features is incredible. Each user gains the advantage of comprehensive portfolio management which would ordinarily take several roles or systems to accomplish."</p>
          <div class="text-gray-800 font-semibold">Timberline Equipment Finance, LLC</div>
        </div>
      </div>
    </section>

    <!-- Pricing Section -->
    <section id="pricing" class="pt-8 mb-8 scroll-mt-40">
      <h2 class="text-2xl font-semibold text-gray-800 mb-6">Pricing</h2>
      <div class="bg-white rounded-lg shadow-md p-6">
        <p class="text-gray-600 mb-4">
          Our pricing scales with your loan portfolio, ensuring affordability from startup to enterprise.
        </p>
        <p class="text-gray-600">
          <Link href="mailto:info@schaake.solutions?subject=FLEX%20Equipment%20Finance">Contact us</Link> for detailed pricing information tailored to your business needs.
        </p>
      </div>
    </section>
  </div>
</Layout>
