---
// One production system: a large italic number, the title, and the
// description passed in the default slot (so the copy stays in index.astro).
interface Props {
  number: string;
  title: string;
}

const { number, title } = Astro.props;
---

<article class="grid gap-4 border-t border-rule py-10 lg:grid-cols-[200px_1fr] lg:gap-10">
  <p class="font-serif text-[3rem] leading-none italic text-accent lg:text-number">{number}</p>
  <div>
    <h3 class="mb-3.5 font-serif text-h3 font-semibold tracking-[-0.01em] text-ink md:text-h3-lg">{title}</h3>
    <p class="max-w-[38rem]"><slot /></p>
  </div>
</article>
