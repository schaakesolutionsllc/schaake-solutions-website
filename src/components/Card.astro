---
interface Props {
	title: string;
	href: string;
  comingSoon: boolean;
}

const { href, title, comingSoon } = Astro.props;
---

<li class="w-full md:w-1/3 md:min-w-96 rounded-lg link-card hover:bg-white flex p-1 border shadow hover:shadow-md">
	<a class="w-full p-2" href={href}>
    <div class="flex justify-between items-center">
		  <h2 class="m-0 font-bold text-lg">
			  {title}
		  </h2>
      {comingSoon && <span class="text-xs text-blue-500">comming soon</span>}
    </div>
		<p class="mt-2 mb-0">
			<slot />
		</p>
	</a>
</li>
