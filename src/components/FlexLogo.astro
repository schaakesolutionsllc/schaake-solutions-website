---
interface Props {
	heightClass: string;
}

const { heightClass } = Astro.props;
const classes = "drop-shadow ml-2 " + heightClass;
---

<svg class={classes} viewBox="0 0 100 80"><polyline points="10,70 40,10 90,10" stroke-width="20" stroke-linejoin="round" stroke-linecap="round" stroke="rgb(9, 13, 75)" fill="none"></polyline><g><polyline points="31,72 46,42" stroke-width="11" stroke-linecap="round" fill="none" stroke="#3f51b5"></polyline><polyline points="48,72 63,42" stroke-width="11" stroke-linecap="round" fill="none" stroke="#3f51b5"></polyline><polyline points="65,72 80,42" stroke-width="11" stroke-linecap="round" fill="none" stroke="#3f51b5"></polyline></g></svg>
